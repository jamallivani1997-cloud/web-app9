{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app9",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9d971ad3-594b-4139-bce5-afcfa97ac1a4","database_name": "web-app7" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7f34336cdd7c4fe0bc43a63d785a0075" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
